// Startup card: current wallpaper (wall-logo.sh) + system summary. Replaces the pokemon card.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/fastfetch/wall-logo.png",
    "width": 24,
    "height": 10,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "output": "white"
    },
    "key": {
      "width": 6
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#1;35}╭─ 󱠡  {#1;97}hello, rhast{#0;35} ──────────────────────"
    },
    {
      "type": "datetime",
      "key": "│ 󰃭 ",
      "keyColor": "magenta",
      "format": "{weekday}, {day-in-month} {month-name}  ·  {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "{#35}├──────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "│  ",
      "keyColor": "blue",
      "format": "{name} {version-id}"
    },
    {
      "type": "kernel",
      "key": "│ 󰘤 ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ 󰖯 ",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "│ 󰏗 ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{#35}├──────────────────────────────────────"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 ",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 ",
      "keyColor": "green",
      "format": "{name}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 ",
      "keyColor": "green",
      "format": "{used} / {total}  ({percentage})"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 ",
      "keyColor": "green",
      "folders": "/",
      "format": "{size-used} / {size-total}  ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "│ 󰁹 ",
      "keyColor": "green",
      "format": "{capacity}  {status}"
    },
    {
      "type": "custom",
      "format": "{#35}├──────────────────────────────────────"
    },
    {
      "type": "media",
      "key": "│ 󰝚 ",
      "keyColor": "yellow",
      "format": "{title} · {artist}"
    },
    {
      "type": "custom",
      "format": "{#35}╰──────────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
