// One continuous translucent strip. Pair with [Glass] Liquid Glass V2.css.
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/UserModules"
  ],
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "height": 40,
  "spacing": 3,
  "fixed-center": true,
  "reload_style_on_change": true,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["custom/menu", "hyprland/workspaces", "custom/playerctl"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "network#wifi", "bluetooth#bt", "pulseaudio", "group/hw_drawer", "custom/clipboard", "custom/nightlight", "custom/swaync", "custom/power"]
}
