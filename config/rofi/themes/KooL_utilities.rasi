/* KooL Hyprland — "utilities" style: matches the Super+X hub, Super+H sheet and the small utility menus.
   Same widget layout as KooL_style-4 so every config-*.rasi override still works.
   Colors come only from wallust (follow the wallpaper). */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "󰀻  apps";
    display-run:                "󰆍  run";
    display-filebrowser:        "󰉋  files";
    display-window:             "󰖯  windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
}

@theme "~/.config/rofi/wallust/colors-rofi.rasi"

/*****----- Global Properties -----*****/
* {
    accent:           @selected-normal-background;
    bg:               @background;
    tile:             rgba(255, 255, 255, 0.05);
    tile-hover:       rgba(255, 255, 255, 0.12);
    fg:               @normal-foreground;
    dim:              rgba(208, 214, 232, 0.55);
    border-color:     @accent;
    background-color: transparent;
    text-color:       @fg;
}

/*****----- Main Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            38%;
    border:           2px solid;
    border-radius:    18px;
    border-color:     @accent;
    background-color: @bg;
    cursor:           "default";
}

/*****----- Main Box -----*****/
mainbox {
    spacing:          14px;
    padding:          22px;
    children:         [ "inputbar", "message", "custombox" ];
}

custombox {
    spacing:          12px;
    orientation:      horizontal;
    children:         [ "mode-switcher", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:          10px;
    padding:          12px 16px;
    border-radius:    12px;
    background-color: @tile;
    children:         [ "textbox-prompt-colon", "entry" ];
}
prompt { text-color: @accent; }
textbox-prompt-colon {
    expand:           false;
    str:              "󰍉";
    text-color:       @accent;
    vertical-align:   0.5;
}
entry {
    cursor:            text;
    placeholder:       "Search…";
    placeholder-color: @dim;
    vertical-align:    0.5;
}
num-filtered-rows, textbox-num-sep, num-rows, case-indicator { expand: false; text-color: @dim; }
textbox-num-sep { str: "/"; }

/*****----- Listview -----*****/
listview {
    columns:          1;
    lines:            7;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          4px;
    cursor:           "default";
}
scrollbar {
    handle-width:     3px;
    handle-color:     @accent;
    border-radius:    10px;
    background-color: @tile;
}

/*****----- Elements -----*****/
element {
    spacing:          12px;
    padding:          9px 12px;
    border:           1px solid;
    border-radius:    10px;
    border-color:     transparent;
    cursor:           pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active, element alternate.active { background-color: transparent; text-color: @accent; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @urgent-background; }
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @tile-hover;
    border-color:     @accent;
    text-color:       @fg;
}
element-icon {
    size:             28px;
    cursor:           inherit;
    text-color:       inherit;
}
element-text {
    text-color:       inherit;
    highlight:        bold #FFFFFF;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    expand:           false;
    orientation:      vertical;
    spacing:          6px;
    padding:          6px;
    border-radius:    12px;
    background-color: @tile;
}
button {
    padding:          0px 16px;
    border-radius:    10px;
    text-color:       @dim;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    cursor:           pointer;
}
button selected {
    background-color: @accent;
    text-color:       @selected-normal-foreground;
}

/*****----- Message -----*****/
message { background-color: transparent; }
textbox {
    padding:          10px 12px;
    border-radius:    10px;
    background-color: @tile;
    text-color:       @fg;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    highlight:        none;
    placeholder-color: @dim;
    blink:            true;
    markup:           true;
}
error-message {
    padding:          12px;
    border:           2px solid;
    border-radius:    12px;
    border-color:     @accent;
    background-color: @bg;
    text-color:       @fg;
}
