{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 40,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "notification-window-width": 380,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 460,
  "control-center-height": 760,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/UserScripts/NetMenu.sh --wifi'"
        },
        {
          "label": "󰂯",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/UserScripts/NetMenu.sh --bluetooth'"
        },
        {
          "label": "󰓅",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/UserScripts/PowerProfile.sh'"
        },
        {
          "label": "󰖨",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/scripts/Hyprsunset.sh toggle'"
        },
        {
          "label": "󰹑",
          "command": "bash -c 'swaync-client -cp; sleep 0.4; $HOME/.config/hypr/scripts/ScreenShot.sh --swappy'"
        },
        {
          "label": "󰑋",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/UserScripts/ScreenRecord.sh --toggle'"
        },
        {
          "label": "󰌾",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/scripts/LockScreen.sh'"
        },
        {
          "label": "󰐥",
          "command": "bash -c 'swaync-client -cp; $HOME/.config/hypr/scripts/Wlogout.sh'"
        }
      ]
    }
  }
}