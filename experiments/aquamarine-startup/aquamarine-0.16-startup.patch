+// Reuse only connected, populated state from scanConnectors() in this process.
+// Unknown, disconnected or empty state always gets a fresh kernel probe.
+static drmModeConnector* currentConnectorOrProbe(int fd, uint32_t id) {
+    auto connector = drmModeGetConnectorCurrent(fd, id);
+    if (connector && connector->connection == DRM_MODE_CONNECTED && connector->count_modes > 0)
+        return connector;
+    if (connector)
+        drmModeFreeConnector(connector);
+    return drmModeGetConnector(fd, id);
+}
+
+static bool hasExplicitDevices() {
+    const char* value = getenv("AQ_DRM_DEVICES");
+    return value && *value;
+}
