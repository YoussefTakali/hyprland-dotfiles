-- Keep the onboard analog output (3.5mm jack) ON even when jack detection
-- (wrongly) reports nothing plugged in. Without this, WirePlumber picks the
-- "off" profile because every analog port is marked unavailable.
-- Only steps in when the normal hooks found nothing or chose "off", so a
-- profile you pick yourself in pavucontrol is still respected.

cutils = require ("common-utils")
log = Log.open_topic ("s-device")

local CARD    = "@CARD@"   -- filled in by the installer (the onboard analog card)
local PROFILE = "output:analog-stereo"

SimpleEventHook {
  name = "local/force-analog-profile",
  after = { "device/find-stored-profile", "device/find-preferred-profile", "device/find-best-profile" },
  before = "device/apply-profile",
  interests = {
    EventInterest {
      Constraint { "event.type", "=", "select-profile" },
    },
  },
  execute = function (event)
    local device = event:get_subject ()
    if device.properties["device.name"] ~= CARD then return end

    local selected = event:get_data ("selected-profile")
    if selected and selected.name ~= "off" then return end

    for p in device:iterate_params ("EnumProfile") do
      local profile = cutils.parseParam (p, "EnumProfile")
      if profile and profile.name == PROFILE then
        log:info (device, "forcing profile " .. PROFILE .. " (jack detection says unplugged)")
        event:set_data ("selected-profile", profile)
        return
      end
    end
  end
}:register ()
